{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Redis: start",
      "type": "shell",
      "command": "docker start securo-redis 2>/dev/null || docker run -d --name securo-redis -p 6379:6379 redis:7-alpine",
      "problemMatcher": []
    },
    {
      "label": "Redis: stop",
      "type": "shell",
      "command": "docker stop securo-redis",
      "problemMatcher": []
    },
    {
      "label": "Backend: install",
      "type": "shell",
      "command": "uv sync --all-extras",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: start",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "dependsOn": ["Backend: install", "Redis: start"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
